# Copia este archivo a .env.local y completa los valores. .env.local NUNCA se sube a git.
# Solo van aquí claves PÚBLICAS: la seguridad real la da RLS en Supabase.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Google Cloud → APIs y servicios → Credenciales (ver docs/GOOGLE_DRIVE.md)
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=AIza...
VITE_GOOGLE_APP_ID=123456789012

# Cloudflare Turnstile (anti-bots en el registro) → https://dash.cloudflare.com → Turnstile
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# Sentry (monitoreo de errores) → Project Settings → Client Keys (DSN)
VITE_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx

# Versión mostrada en el pie de la app (Cloudflare Pages la rellena con el commit)
VITE_APP_VERSION=dev
